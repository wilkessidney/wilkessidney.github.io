---
import { getCollection } from 'astro:content';
import { SITE } from '../utils/site';
import { useTranslations } from '../i18n/ui';

const t = useTranslations();
const [profileEntry] = await getCollection('profile');
const profile = profileEntry?.data;
const year = new Date().getFullYear();

/** 平台 → 内联 SVG 与品牌背景色。缺失的回退到 GitHub 灰。 */
const SOCIAL_ICONS: Record<
  string,
  { bg: string; fg: string; svg: string }
> = {
  github: {
    bg: '#24292f',
    fg: '#ffffff',
    svg: `<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.18c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.77.11 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>`,
  },
  mail: {
    bg: '#f3f4f6',
    fg: '#374151',
    svg: `<path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-11Zm2.4.5 6.6 4.4L18.6 7H5.4Zm15.1 1.4-6.83 4.55a1 1 0 0 1-1.34 0L5.5 8.4V17.5c0 .28.22.5.5.5h12c.28 0 .5-.22.5-.5V8.4Z"/>`,
  },
  instagram: {
    bg: 'linear-gradient(135deg,#f9ce34 0%,#ee2a7b 35%,#6228d7 70%)',
    fg: '#ffffff',
    svg: `<path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 1.5A3 3 0 0 0 4.5 7.5v9a3 3 0 0 0 3 3h9a3 3 0 0 0 3-3v-9a3 3 0 0 0-3-3h-9Zm9.75 2.25a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8ZM12 7.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 1.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>`,
  },
  linkedin: {
    bg: '#0a66c2',
    fg: '#ffffff',
    svg: `<path d="M4.5 3.5A1.75 1.75 0 1 1 4.49 7a1.75 1.75 0 0 1 .01-3.5ZM3 9h3v12H3V9Zm5 0h2.85v1.65h.04c.4-.75 1.36-1.54 2.8-1.54C16.6 9.11 18 11 18 14v7h-3v-6.2c0-1.48-.03-3.39-2.07-3.39-2.07 0-2.39 1.62-2.39 3.29V21H8V9Z"/>`,
  },
  twitter: {
    bg: '#1d9bf0',
    fg: '#ffffff',
    svg: `<path d="M18.244 3H21l-6.55 7.49L22 21h-6.063l-4.747-6.21L5.7 21H3l7.02-8.025L2.5 3h6.218l4.29 5.67L18.244 3Zm-1.06 16.2h1.68L7.93 4.7H6.13L17.184 19.2Z"/>`,
  },
  rss: {
    bg: '#f26522',
    fg: '#ffffff',
    svg: `<path d="M4 4.5a15.5 15.5 0 0 1 15.5 15.5h-3A12.5 12.5 0 0 0 4 7.5v-3Zm0 6a9.5 9.5 0 0 1 9.5 9.5h-3A6.5 6.5 0 0 0 4 13.5v-3Zm2.5 7.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5Z"/>`,
  },
};

const fallback = SOCIAL_ICONS.github;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="copyright">
      © {SITE.since}–{year}
      {profile?.name ?? SITE.author}
      <span aria-hidden="true"> · </span>{t('footer.rights')}
    </p>
    {SITE.icp && <p class="icp">{SITE.icp}</p>}
  </div>

  <!-- 社交连接：参考截图的圆形图标按钮 -->
  <div class="container social-row" aria-label="社交连接">
    {
      (profile?.socialLinks ?? []).map((link) => {
        const def = SOCIAL_ICONS[link.icon ?? ''] ?? fallback;
        const isMail = (link.url ?? '').startsWith('mailto:');
        return (
          <a
            class="social-circle"
            href={link.url}
            target={isMail || link.url.startsWith('/') ? undefined : '_blank'}
            rel={isMail || link.url.startsWith('/') ? undefined : 'me noopener noreferrer'}
            aria-label={link.label}
            title={link.label}
          >
            <svg
              viewBox="0 0 24 24"
              fill={def.fg}
              aria-hidden="true"
              style={`background:${def.bg}`}
            >
              <Fragment set:html={def.svg} />
            </svg>
          </a>
        );
      })
    }
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
    font-size: 0.875rem;
  }

  .footer-inner {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .copyright {
    line-height: 1.7;
  }

  .icp {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
  }

  .social-row {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .social-circle {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    overflow: hidden;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .social-circle:hover,
  .social-circle:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
    outline: none;
  }

  .social-circle svg {
    width: 100%;
    height: 100%;
    padding: 0.4375rem;
    box-sizing: border-box;
    border-radius: 50%;
  }
</style>
