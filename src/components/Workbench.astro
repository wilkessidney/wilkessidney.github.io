---
import type { CollectionEntry } from 'astro:content';
import { formatDate, calcReadingTime, formatDateShort } from '../utils/helpers';
import { useTranslations } from '../i18n/ui';

interface Props {
  works: CollectionEntry<'works'>[];
  articles: CollectionEntry<'articles'>[];
  notes: CollectionEntry<'notes'>[];
  daily: CollectionEntry<'daily'>[];
}

const { works, articles, notes, daily } = Astro.props;
const t = useTranslations();

const latestWorks = works.slice(0, 6);
const latestArticles = articles.slice(0, 4);
const latestNotes = notes.slice(0, 6);
const latestDaily = daily.slice(0, 5);

const tabs = [
  { id: 'works', label: t('home.tab.works'), count: works.length },
  { id: 'writing', label: t('home.tab.writing'), count: articles.length },
  { id: 'notes', label: t('home.tab.notes'), count: notes.length },
  { id: 'archive', label: t('home.tab.archive'), count: daily.length },
] as const;
---

<div class="workbench">
  <!-- 标签切换 -->
  <div class="cb-tabs" role="tablist" aria-label="工作台分类">
    {
      tabs.map((tab, idx) => (
        <button
          class={`cb-tab${idx === 0 ? ' is-active' : ''}`}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          aria-controls={`cb-panel-${tab.id}`}
          id={`cb-tab-${tab.id}`}
          data-tab={tab.id}
          type="button"
        >
          <span class="cb-tab-label">{tab.label}</span>
          <span class="cb-tab-count">{tab.count}</span>
        </button>
      ))
    }
  </div>

  <!-- 作品 -->
  <section
    class="cb-panel is-active"
    id="cb-panel-works"
    role="tabpanel"
    aria-labelledby="cb-tab-works"
  >
    <div class="cb-panel-head">
      <h2 class="cb-panel-title">{t('home.featuredWorks')}</h2>
      <a class="cb-panel-more" href="/works">{t('home.viewAll')} →</a>
    </div>
    <div class="cb-grid cb-grid-3">
      {
        latestWorks.map((work) => (
          <div class="cb-card cb-card-work">
            <a class="cb-card-main" href={`/works/${work.id}`}>
              <span class="cb-card-dot" style={`--dot-color: var(--accent)`} />
              <div class="cb-card-body">
                <h3 class="cb-card-title">{work.data.title}</h3>
                <p class="cb-card-desc">{work.data.summary}</p>
              </div>
              <div class="cb-card-foot">
                <span class="cb-pill">{work.data.type}</span>
                <span class="cb-meta">{work.data.year}</span>
              </div>
            </a>
            {
              work.data.links.length > 0 && (
                <div class="cb-card-links">
                  {work.data.links.map((link) => (
                    <a
                      class="cb-link-chip"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      onclick="event.stopPropagation()"
                      data-kind={/github\.com/i.test(link.url) ? 'github' : /mp\.weixin|小程序/i.test(link.url) ? 'miniprogram' : 'site'}
                    >
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        ))
      }
      {latestWorks.length === 0 && <p class="cb-empty">还没有作品。</p>}
    </div>
  </section>

  <!-- 文章 -->
  <section
    class="cb-panel"
    id="cb-panel-writing"
    role="tabpanel"
    aria-labelledby="cb-tab-writing"
    hidden
  >
    <div class="cb-panel-head">
      <h2 class="cb-panel-title">{t('home.latestArticles')}</h2>
      <a class="cb-panel-more" href="/writing">{t('home.viewAll')} →</a>
    </div>
    <div class="cb-grid cb-grid-2">
      {
        latestArticles.map((article) => {
          const minutes = article.data.readingTime ?? calcReadingTime(article.body ?? '');
          return (
            <a class="cb-card cb-card-article" href={`/writing/${article.id}`}>
              <span class="cb-card-dot" style={`--dot-color: var(--accent)`} />
              <div class="cb-card-body">
                <h3 class="cb-card-title">
                  {article.data.title}
                  {article.data.featured && <span class="cb-badge">精选</span>}
                </h3>
                <p class="cb-card-desc">{article.data.summary}</p>
              </div>
              <div class="cb-card-foot">
                <span class="cb-pill">{article.data.category}</span>
                <span class="cb-meta">
                  {formatDateShort(article.data.date)} · {minutes} 分钟
                </span>
              </div>
            </a>
          );
        })
      }
      {latestArticles.length === 0 && <p class="cb-empty">还没有文章。</p>}
    </div>
  </section>

  <!-- 思考 -->
  <section
    class="cb-panel"
    id="cb-panel-notes"
    role="tabpanel"
    aria-labelledby="cb-tab-notes"
    hidden
  >
    <div class="cb-panel-head">
      <h2 class="cb-panel-title">{t('home.recentNotes')}</h2>
      <a class="cb-panel-more" href="/notes">{t('home.viewAll')} →</a>
    </div>
    <div class="cb-grid cb-grid-2">
      {
        latestNotes.map((note) => (
          <a class="cb-card cb-card-note" href={`/notes/${note.id}`}>
            <span class="cb-card-dot" style={`--dot-color: var(--accent)`} />
            <div class="cb-card-body">
              <p class="cb-note-text">{note.body}</p>
            </div>
            <div class="cb-card-foot">
              <span class="cb-meta">{formatDateShort(note.data.date)}</span>
              {note.data.tags.length > 0 && (
                <span class="cb-pill">{note.data.tags[0]}</span>
              )}
            </div>
          </a>
        ))
      }
      {latestNotes.length === 0 && <p class="cb-empty">还没有思考。</p>}
    </div>
  </section>

  <!-- 归档 / 日计划 -->
  <section
    class="cb-panel"
    id="cb-panel-archive"
    role="tabpanel"
    aria-labelledby="cb-tab-archive"
    hidden
  >
    <div class="cb-panel-head">
      <h2 class="cb-panel-title">{t('home.recentDaily')}</h2>
      <a class="cb-panel-more" href="/daily">{t('home.viewAll')} →</a>
    </div>
    <div class="cb-daily-list">
      {
        latestDaily.map((plan) => {
          const done = plan.data.tasks.filter((task) => task.done).length;
          const total = plan.data.tasks.length;
          const progress = total > 0 ? Math.round((done / total) * 100) : 0;
          return (
            <a class="cb-card cb-card-daily" href={`/daily`}>
              <div class="cb-daily-main">
                <span class="cb-daily-date">{formatDate(plan.data.date)}</span>
                <span class={`cb-daily-status cb-daily-status-${plan.data.status}`}>
                  {plan.data.status}
                </span>
              </div>
              {plan.data.summary && <p class="cb-daily-summary">{plan.data.summary}</p>}
              {total > 0 && (
                <div class="cb-daily-progress">
                  <div class="cb-daily-bar" style={`width: ${progress}%`} />
                  <span class="cb-meta">{done}/{total}</span>
                </div>
              )}
            </a>
          );
        })
      }
      {latestDaily.length === 0 && <p class="cb-empty">还没有日计划。</p>}
    </div>
  </section>
</div>

<style is:global>
  .workbench {
    padding: 1.5rem 0 3rem;
  }

  .cb-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cb-tabs::-webkit-scrollbar {
    display: none;
  }

  .cb-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all var(--t-fast);
    white-space: nowrap;
  }

  .cb-tab:hover {
    background: var(--bg-soft);
    color: var(--text);
  }

  .cb-tab.is-active {
    background: var(--accent-soft);
    color: var(--accent);
    border-color: var(--accent-soft);
  }

  .cb-tab-count {
    font-size: 0.75rem;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text-faint);
  }

  .cb-tab.is-active .cb-tab-count {
    background: var(--card);
    color: var(--accent);
  }

  .cb-panel {
    display: none;
  }

  .cb-panel.is-active {
    display: block;
    animation: cb-fade-in 0.2s ease;
  }

  @keyframes cb-fade-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cb-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .cb-panel-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text);
  }

  .cb-panel-more {
    font-size: 0.875rem;
    color: var(--text-soft);
  }

  .cb-panel-more:hover {
    color: var(--accent);
  }

  .cb-grid {
    display: grid;
    gap: 1rem;
  }

  .cb-grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cb-grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .cb-grid-2,
    .cb-grid-3 {
      grid-template-columns: 1fr;
    }
  }

  .cb-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: inherit;
    transition: border-color var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
    position: relative;
    overflow: hidden;
  }

  .cb-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--dot-color, var(--accent));
    opacity: 0;
    transition: opacity var(--t-fast);
  }

  .cb-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .cb-card:hover::before {
    opacity: 1;
  }

  .cb-card-dot {
    display: none;
  }

  /* 作品卡：主链接区 + 外部链接页脚 */
  .cb-card-work {
    gap: 0;
    padding: 0;
  }

  .cb-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.1rem 1.25rem;
    color: inherit;
    flex: 1 1 auto;
  }

  .cb-card-main:hover .cb-card-title {
    color: var(--accent);
  }

  .cb-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 1.25rem 1.15rem;
    border-top: 1px solid var(--border-soft);
    margin-top: 0.25rem;
    padding-top: 0.85rem;
  }

  .cb-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8125rem;
    line-height: 1;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text-soft);
    transition: all var(--t-fast);
  }

  .cb-link-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .cb-link-chip[data-kind='github'] {
    border-color: var(--accent-soft);
    color: var(--accent);
  }

  .cb-card-body {
    flex: 1 1 auto;
  }

  .cb-card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .cb-card:hover .cb-card-title {
    color: var(--accent);
  }

  .cb-card-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cb-note-text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text);
    white-space: pre-wrap;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cb-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .cb-pill {
    font-size: 0.75rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    white-space: nowrap;
  }

  .cb-meta {
    font-size: 0.8125rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .cb-badge {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0 0.3rem;
    margin-left: 0.4rem;
    vertical-align: 0.1em;
  }

  .cb-empty {
    grid-column: 1 / -1;
    padding: 2rem;
    text-align: center;
    color: var(--text-faint);
    font-size: 0.9375rem;
  }

  /* 日计划列表 */
  .cb-daily-list {
    display: grid;
    gap: 0.85rem;
  }

  .cb-card-daily {
    gap: 0.5rem;
    padding: 0.95rem 1.15rem;
  }

  .cb-daily-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .cb-daily-date {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .cb-daily-status {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-soft);
  }

  .cb-daily-status-已完成,
  .cb-daily-status-复盘 {
    color: var(--success, #3fb950);
    border-color: var(--success, #3fb950);
  }

  .cb-daily-status-进行中 {
    color: var(--accent);
    border-color: var(--accent);
  }

  .cb-daily-summary {
    font-size: 0.875rem;
    color: var(--text-soft);
    line-height: 1.6;
  }

  .cb-daily-progress {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
  }

  .cb-daily-bar {
    height: 5px;
    background: var(--accent);
    border-radius: 999px;
    min-width: 24px;
  }
</style>

<script>
  (function setupWorkbenchTabs() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.cb-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.cb-panel'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        tabs.forEach((t) => {
          const active = t === tab;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => {
          const active = p.id === `cb-panel-${id}`;
          p.classList.toggle('is-active', active);
          p.hidden = !active;
        });
      });
    });
  })();
</script>
