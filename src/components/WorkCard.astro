---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, year, summary, cover, type, tags, tools, featured } =
  work.data;
---

<article class="card card-link work-card">
  <a class="work-link" href={`/works/${work.id}`}>
    {
      cover ? (
        <div class="work-cover">
          <img src={cover} alt={`${title} 封面`} loading="lazy" width="800" height="450" />
        </div>
      ) : (
        <div class="work-cover work-cover-fallback" aria-hidden="true">
          <span>{title.slice(0, 1)}</span>
        </div>
      )
    }

    <div class="work-body">
      <div class="work-meta">
        <span class="work-type">{type}</span>
        <span>{year}</span>
        {featured && <span class="work-featured">精选</span>}
      </div>

      <h3 class="work-title">{title}</h3>
      <p class="work-summary">{summary}</p>

      {
        (tags.length > 0 || tools.length > 0) && (
          <ul class="tag-list work-tags">
            {tools.slice(0, 3).map((tool) => (
              <li>
                <span class="tag">{tool}</span>
              </li>
            ))}
            {tags.slice(0, 3).map((tag) => (
              <li>
                <a
                  class="tag"
                  href={`/tags/${encodeURIComponent(tag)}`}
                  onclick="event.stopPropagation()"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>

<style>
  .work-card {
    padding: 0;
    overflow: hidden;
  }

  .work-link {
    display: block;
    color: inherit;
  }

  .work-cover {
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }

  .work-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-cover-fallback {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 2.5rem;
    font-weight: 600;
  }

  .work-body {
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-bottom: 0.55rem;
  }

  .work-type {
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
  }

  .work-featured {
    margin-left: auto;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 4px;
    padding: 0 0.3rem;
  }

  .work-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color var(--t-fast);
  }

  .work-link:hover .work-title {
    color: var(--accent);
  }

  .work-summary {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-soft);
    margin-top: 0.5rem;
  }

  .work-tags {
    margin-top: 0.9rem;
  }
</style>
