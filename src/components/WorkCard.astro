---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, year, summary, cover, type, tags, tools, featured, links } =
  work.data;

// 根据链接 URL 推断图标，用于作品卡上直观区分 GitHub / 网站 / 小程序
function linkIcon(url: string): string {
  if (/github\.com/i.test(url)) return '⌥'; // 代码仓库
  if (/mp\.weixin\.qq\.com|weixin|小程序/i.test(url)) return '▢'; // 小程序
  return '↗'; // 在线访问
}
---

<article class="card work-card">
  <a class="work-link" href={`/works/${work.id}`}>
    {
      cover ? (
        <div class="work-cover">
          <img src={cover} alt={`${title} 封面`} loading="lazy" width="800" height="450" />
        </div>
      ) : (
        <div class="work-cover work-cover-fallback" aria-hidden="true">
          <span>{title.slice(0, 1)}</span>
        </div>
      )
    }

    <div class="work-body">
      <div class="work-meta">
        <span class="work-type">{type}</span>
        <span>{year}</span>
        {featured && <span class="work-featured">精选</span>}
      </div>

      <h3 class="work-title">{title}</h3>
      <p class="work-summary">{summary}</p>
    </div>
  </a>

  <!-- 标签放在主链接外：卡内不能再嵌 <a>，否则 DOM 会被浏览器解析器撕碎 -->
  {
    (tags.length > 0 || tools.length > 0) && (
      <ul class="tag-list work-tags">
        {tools.slice(0, 3).map((tool) => (
          <li>
            <span class="tag">{tool}</span>
          </li>
        ))}
        {tags.slice(0, 3).map((tag) => (
          <li>
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    links.length > 0 && (
      <footer class="work-links">
        {links.map((link) => (
          <a
            class="work-link-chip"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            data-kind={/github\.com/i.test(link.url) ? 'github' : /mp\.weixin|小程序/i.test(link.url) ? 'miniprogram' : 'site'}
          >
            <span class="work-link-ico" aria-hidden="true">{linkIcon(link.url)}</span>
            <span>{link.label}</span>
          </a>
        ))}
      </footer>
    )
  }
</article>

<style>
  .work-card {
    padding: 0;
    overflow: hidden;
    transition: border-color var(--t-base), transform var(--t-base),
      box-shadow var(--t-base);
  }

  .work-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .work-link {
    display: block;
    color: inherit;
  }

  .work-cover {
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border-soft);
    overflow: hidden;
  }

  .work-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-cover-fallback {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 2.5rem;
    font-weight: 600;
  }

  .work-body {
    padding: 1.25rem 1.4rem 1.4rem;
  }

  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-bottom: 0.55rem;
  }

  .work-type {
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 4px;
    padding: 0.05rem 0.4rem;
  }

  .work-featured {
    margin-left: auto;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 4px;
    padding: 0 0.3rem;
  }

  .work-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
    transition: color var(--t-fast);
  }

  .work-link:hover .work-title {
    color: var(--accent);
  }

  .work-summary {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-soft);
    margin-top: 0.5rem;
  }

  .work-tags {
    margin: 0.2rem 1.4rem 1rem;
  }

  /* 无链接页脚时，标签块自己提供底部留白 */
  .work-card > .work-tags:last-child {
    margin-bottom: 1.25rem;
  }

  .work-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 1.4rem 1.25rem;
  }

  .work-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text-soft);
    transition: all var(--t-fast);
  }

  .work-link-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .work-link-ico {
    font-size: 0.9rem;
  }

  .work-link-chip[data-kind='github'] .work-link-ico {
    color: var(--accent);
  }
</style>
