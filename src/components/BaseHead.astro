---
import { SITE } from '../utils/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 是否为内容详情页（会额外输出 article 相关 meta） */
  article?: boolean;
  pubDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  noindex = false,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${SITE.title}`
  : `${SITE.title} — ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

// ---- 结构化数据（SEO 富媒体 + GEO 实体识别）----
const webSiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: SITE.author, url: SITE.url + '/about/' },
};

const articleLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title ?? SITE.title,
      description,
      datePublished: pubDate ? pubDate.toISOString() : undefined,
      dateModified: (updatedDate ?? pubDate)?.toISOString(),
      author: { '@type': 'Person', name: SITE.author, url: SITE.url + '/about/' },
      publisher: { '@type': 'Person', name: SITE.author },
      keywords: tags.join(', '),
      image: ogImageUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    }
  : null;

const breadcrumbLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url + '/' },
        { '@type': 'ListItem', position: 2, name: '文章', item: SITE.url + '/writing/' },
        { '@type': 'ListItem', position: 3, name: title ?? SITE.title, item: canonical },
      ],
    }
  : null;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.title} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="zh_CN" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  article && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href="/rss.xml"
/>

<!--
  主题初始化：必须在页面渲染前同步执行，避免深色模式下的白屏闪烁。
  使用 is:inline 防止 Astro 把这段脚本延迟加载。
-->
<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem('theme');
      var prefersDark =
        window.matchMedia &&
        window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = stored || 'dark';
    } catch (e) {
      document.documentElement.dataset.theme = 'dark';
    }
    // 强调色：与工作台一致的色板，记忆用户选择，避免闪烁
    try {
      var a = localStorage.getItem('accent');
      if (a) {
        var p = JSON.parse(a);
        if (p && p.accent) {
          var r = document.documentElement.style;
          r.setProperty('--accent', p.accent);
          if (p.soft) r.setProperty('--accent-soft', p.soft);
          if (p.ring) r.setProperty('--accent-ring', p.ring);
        }
      }
    } catch (e) {}
  })();
</script>

<!-- 结构化数据：WebSite（全站）/ Article + BreadcrumbList（文章页） -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(webSiteLd)} />
{articleLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />}
{breadcrumbLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />}
