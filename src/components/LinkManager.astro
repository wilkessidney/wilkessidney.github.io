---
import { getCollection } from 'astro:content';

const [profileEntry] = await getCollection('profile');
const profile = profileEntry?.data;

// 分类色板（与博客强调色同族）
const CATS = [
  { k: '量化研究', c: '#3fb950' },
  { k: '预测市场', c: '#a371f7' },
  { k: 'AI 全栈', c: '#58a6ff' },
  { k: '学习成长', c: '#d29922' },
  { k: '内容输出', c: '#f778ba' },
];

// 首次访问的默认数据：与顶部导航一致的三层——作品 / 文章 / 思考。
const DEFAULT_DATA = [
  { _id: 'seed_polymarket', title: 'Polymarket.fans', url: '/works/polymarket-fans', layer: '作品', cat: '预测市场', desc: '预测市场数据平台', status: '已发布', pin: true, hits: 0, created: '2026-08-31' },
  { _id: 'seed_okx', title: 'OKX 量化策略研究系统', url: '/works/okx-quant', layer: '作品', cat: '量化研究', desc: '多因子策略回测框架', status: '已发布', pin: true, hits: 0, created: '2026-08-31' },
  { _id: 'seed_age', title: 'AGE ERP 系统', url: '/works/age-erp', layer: '作品', cat: 'AI 全栈', desc: '亚马逊 ERP 工具', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_works', title: '作品', url: '/works', layer: '作品', cat: 'AI 全栈', desc: '做过的事', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_github', title: 'GitHub', url: 'https://github.com/wilkessidney', layer: '作品', cat: 'AI 全栈', desc: '源码仓库', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_writing', title: '文章', url: '/writing', layer: '文章', cat: '内容输出', desc: '量化、全栈与读书笔记', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_rss', title: 'RSS', url: '/rss.xml', layer: '文章', cat: '内容输出', desc: '订阅更新', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_notes', title: '思考', url: '/notes', layer: '思考', cat: '内容输出', desc: '日常想法与碎片', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_archive', title: '日计划', url: '/daily', layer: '思考', cat: '内容输出', desc: '每日计划与复盘', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_about', title: '关于', url: '/about', layer: '思考', cat: '学习成长', desc: '我是谁', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
  { _id: 'seed_search', title: '搜索', url: '/search', layer: '思考', cat: 'AI 全栈', desc: '站内检索', status: '已发布', pin: false, hits: 0, created: '2026-08-31' },
];
---

<div class="wb">
  <section class="wb-hero">
    <div class="wb-hero-h">
      <h2>收藏夹</h2>
      <span class="wb-hint">自建导航 · 数据存本地</span>
      <span class="wb-line"></span>
    </div>
    <div class="wb-stats">
      <div class="wb-stat"><b id="s1">0</b>作品</div>
      <div class="wb-stat"><b id="s2">0</b>文章</div>
      <div class="wb-stat"><b id="s3">0</b>思考</div>
      <div class="wb-stat"><b id="s4">0</b>全部</div>
    </div>
  </section>

  <div class="wb-msg" id="msg"></div>

  <section class="wb-sec">
    <div class="wb-sec-h">
      <h2>每日高频</h2>
      <span class="wb-hint">置顶项，随手就开</span>
      <span class="wb-line"></span>
    </div>
    <div class="wb-pins" id="pins"></div>
  </section>

  <section class="wb-sec">
    <div class="wb-tabs">
      <button class="wb-tab on" data-tab="作品">作品<span class="wb-n" id="n1"></span></button>
      <button class="wb-tab" data-tab="文章">文章<span class="wb-n" id="n2"></span></button>
      <button class="wb-tab" data-tab="思考">思考<span class="wb-n" id="n3"></span></button>
    </div>
    <div class="wb-bar">
      <input class="wb-search" id="q" type="text" placeholder="搜索标题或描述…" autocomplete="off" />
      <div class="wb-chips" id="chips"></div>
    </div>
    <div id="list"></div>
  </section>

  <section class="wb-form">
    <div class="wb-form-h">
      <h2 id="formT">添加一条</h2>
      <button class="wb-btn wb-sm" id="cancelBtn" type="button" style="display:none">取消编辑</button>
    </div>
    <form id="addForm">
      <div class="wb-frow">
        <div class="wb-fi"><label>标题 *</label><input id="f_title" type="text" required placeholder="Polymarket.fans" /></div>
        <div class="wb-fi"><label>链接 *</label><input id="f_url" type="url" required placeholder="https://… 或 /writing" /></div>
      </div>
      <div class="wb-frow">
        <div class="wb-fi"><label>层级</label><select id="f_layer"><option>作品</option><option>文章</option><option selected>思考</option></select></div>
        <div class="wb-fi"><label>分类</label>
          <div class="wb-cat-row">
            <select id="f_cat"></select>
            <button type="button" class="wb-addcat" id="addCatBtn" title="新增分类">＋</button>
            <input id="f_newcat" type="text" placeholder="新分类名 · 回车添加" maxlength="12" style="display:none" />
          </div>
        </div>
        <div class="wb-fi"><label>状态</label><select id="f_status"><option>已发布</option><option>待整理</option></select></div>
      </div>
      <div class="wb-frow">
        <div class="wb-fi"><label>描述</label><input id="f_desc" type="text" placeholder="一句话说清这是什么" /></div>
      </div>
      <div class="wb-form-actions">
        <label class="wb-toggle"><input id="f_pin" type="checkbox" /><span>置顶到「每日高频」</span></label>
        <button class="wb-btn wb-pri" id="submitBtn" type="submit">添加</button>
      </div>
    </form>
  </section>

  <footer class="wb-foot">
    <div class="wb-fbtns">
      <button class="wb-btn wb-sm" id="expBtn" type="button">导出 JSON</button>
      <button class="wb-btn wb-sm" id="impBtn" type="button">导入</button>
      <input type="file" id="impFile" accept=".json" style="display:none" />
      <button class="wb-btn wb-sm" id="clrBtn" type="button">清空全部</button>
    </div>
    <div class="wb-sync" id="sync"><i></i><span>已存本地</span></div>
  </footer>
</div>

<style is:global>
  .wb {
  max-width: 62rem;
  margin-inline: auto;
  padding-bottom: 3rem;
}
  .wb-hero {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 20px;
  }
  .wb-hero-h { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .wb-hero-h h2 { font-size: 15px; font-weight: 600; color: var(--text); }
  .wb-hero-top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .wb-avatar {
    width: 52px; height: 52px; border-radius: 12px;
    border: 1px solid var(--border); flex-shrink: 0; object-fit: cover;
  }
  .wb-hero h1 { font-size: 19px; font-weight: 600; letter-spacing: .3px; color: var(--text); }
  .wb-sub { color: var(--text-soft); font-size: 13px; margin-top: 2px; }
  .wb-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
  .wb-tag {
    font-size: 12px; padding: 3px 10px; border-radius: 20px;
    background: var(--bg-soft); border: 1px solid var(--border-soft); color: var(--text-soft);
  }
  .wb-stats {
    display: flex; gap: 22px; margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--border); flex-wrap: wrap;
  }
  .wb-stat { font-size: 12px; color: var(--text-soft); }
  .wb-stat b { display: block; font-size: 20px; color: var(--text); font-weight: 600; line-height: 1.2; }

  .wb-msg {
    font-size: 12px; padding: 8px 12px; border-radius: 7px; margin-bottom: 14px; display: none;
  }
  .wb-msg.show { display: block; }
  .wb-msg.ok {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }
  .wb-msg.err { background: rgba(248,81,73,.12); border: 1px solid rgba(248,81,73,.3); color: #f85149; }

  .wb-sec { margin-bottom: 24px; }
  .wb-sec-h { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .wb-sec-h h2 { font-size: 15px; font-weight: 600; color: var(--text); }
  .wb-hint { font-size: 12px; color: var(--text-soft); font-weight: 400; }
  .wb-line { flex: 1; height: 1px; background: var(--border); }

  /* 每日高频 */
  .wb-pins { display: flex; gap: 12px; overflow-x: auto; padding: 4px 2px 10px; }
  .wb-pin {
    flex: 0 0 auto; width: 184px;
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 16px 14px; text-decoration: none; color: var(--text); display: block;
    position: relative; overflow: hidden;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .wb-pin::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: var(--pin-color, var(--accent)); opacity: .85;
  }
  .wb-pin:hover {
    border-color: var(--accent); transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0,0,0,.08);
  }
  .wb-pin .wb-pt { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
  .wb-pin .wb-pd { font-size: 12px; color: var(--text-soft); line-height: 1.45; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .wb-tabs {
    display: flex; gap: 4px; background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 4px; margin-bottom: 14px; flex-wrap: wrap;
  }
  .wb-tab {
    flex: 1; min-width: 90px; padding: 8px 12px; border: 0; background: transparent;
    color: var(--text-soft); font-size: 13px; font-family: inherit; border-radius: 7px; cursor: pointer; transition: .15s;
  }
  .wb-tab:hover { color: var(--text); }
  .wb-tab.on { background: var(--bg-soft); color: var(--text); box-shadow: inset 0 0 0 1px var(--border); }
  .wb-tab .wb-n { font-size: 11px; opacity: .7; margin-left: 4px; }

  .wb-bar { display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .wb-search {
    flex: 1; min-width: 200px; background: var(--bg-soft); border: 1px solid var(--border);
    border-radius: 8px; padding: 9px 12px; color: var(--text); font-size: 13px; font-family: inherit; outline: none;
  }
  .wb-search:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-ring); }
  .wb-chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .wb-chip {
    padding: 7px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--card);
    color: var(--text-soft); font-size: 12px; cursor: pointer; font-family: inherit; transition: .15s;
    display: flex; align-items: center; gap: 6px;
  }
  .wb-chip:hover { border-color: var(--border); color: var(--text); }
  .wb-chip.on { background: var(--bg-soft); color: var(--text); border-color: var(--border); }
  .wb-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

  /* 链接列表 */
  .wb-grid { display: grid; gap: 12px; }
  .wb-grid.works { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .wb-grid.res { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .wb-card {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 14px 16px; position: relative;
    transition: border-color .15s, transform .15s, box-shadow .15s;
  }
  .wb-card:hover {
    border-color: var(--accent); transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0,0,0,.08);
  }
  .wb-card-ops {
    position: absolute; top: 10px; right: 10px;
    display: flex; gap: 4px; opacity: 0; transition: opacity .15s;
  }
  .wb-card:hover .wb-card-ops { opacity: 1; }
  .wb-card .wb-ct { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; padding-right: 78px; }
  .wb-card .wb-ct a {
    color: var(--text); text-decoration: none; font-size: 14px; font-weight: 600; flex: 1;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .wb-card .wb-ct a:hover { color: var(--accent); }
  .wb-card .wb-cd { font-size: 12px; color: var(--text-soft); line-height: 1.55; min-height: 19px; margin-bottom: 10px; }
  .wb-card .wb-cf { display: flex; align-items: center; gap: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .wb-pill {
    font-size: 11px; padding: 3px 9px; border-radius: 20px;
    border: 1px solid var(--border); color: var(--text-soft); background: var(--bg-soft);
  }
  .wb-hits { font-size: 11px; color: var(--text-soft); margin-left: auto; }
  .wb-ops { display: flex; gap: 4px; }
  .wb-op {
    border: 1px solid transparent; background: transparent; color: var(--text-soft);
    border-radius: 6px; padding: 3px 8px; font-size: 11px; cursor: pointer; font-family: inherit;
    transition: .15s;
  }
  .wb-op:hover { background: var(--bg-soft); color: var(--text); }
  .wb-op.del:hover { color: #f85149; background: rgba(248,81,73,.08); }

  .wb-empty { text-align: center; padding: 40px 20px; color: var(--text-soft); font-size: 13px; border: 1px dashed var(--border); border-radius: 11px; }

  /* 添加表单 */
  .wb-form { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 18px; margin-bottom: 20px; }
  .wb-form-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .wb-form-h h2 { font-size: 15px; font-weight: 600; color: var(--text); }
  .wb-frow { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 12px; }
  .wb-fi { display: flex; flex-direction: column; gap: 5px; }
  .wb-fi label { font-size: 11px; color: var(--text-soft); }
  .wb-fi input, .wb-fi select, .wb-fi textarea {
    background: var(--bg-soft); border: 1px solid var(--border); border-radius: 7px;
    padding: 8px 10px; color: var(--text); font-size: 13px; font-family: inherit; outline: none;
  }
  .wb-fi input:focus, .wb-fi select:focus, .wb-fi textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-ring); }
  .wb-cat-row { display: flex; gap: 6px; align-items: center; }
  .wb-cat-row select, .wb-cat-row input { flex: 1; min-width: 0; }
  .wb-addcat {
    flex: 0 0 auto; width: 34px; height: 34px; border-radius: 7px;
    border: 1px dashed var(--border); background: var(--bg-soft); color: var(--text-soft);
    font-size: 15px; cursor: pointer; font-family: inherit; line-height: 1; transition: .15s;
  }
  .wb-addcat:hover { border-color: var(--accent); color: var(--accent); }

  .wb-form-actions {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 4px; padding-top: 14px; border-top: 1px solid var(--border);
  }
  .wb-toggle { display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; color: var(--text-soft); }
  .wb-toggle input { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }
  .wb-btns { display: flex; gap: 8px; margin-top: 4px; flex-wrap: wrap; }
  .wb-btn {
    padding: 8px 18px; border-radius: 7px; border: 1px solid var(--border); background: var(--bg-soft);
    color: var(--text); font-size: 13px; cursor: pointer; font-family: inherit; transition: .15s;
  }
  .wb-btn:hover { border-color: var(--accent); color: var(--accent); }
  .wb-btn.pri { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 500; }
  .wb-btn.pri:hover { opacity: .9; color: var(--bg); }
  .wb-btn.sm { padding: 6px 12px; font-size: 12px; }

  .wb-foot {
    border-top: 1px solid var(--border); padding-top: 16px; display: flex;
    justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
    font-size: 12px; color: var(--text-soft);
  }
  .wb-fbtns { display: flex; gap: 8px; flex-wrap: wrap; }
  .wb-sync { display: flex; align-items: center; gap: 6px; }
  .wb-sync i { width: 7px; height: 7px; border-radius: 50%; background: #3fb950; display: block; }

  @media (max-width: 640px) {
    .wb-hero { padding: 18px; }
    .wb-stats { gap: 16px; }
    .wb-grid.works, .wb-grid.res { grid-template-columns: 1fr; }
    .wb-card-ops { opacity: 1; position: static; margin-top: 8px; justify-content: flex-end; }
    .wb-card .wb-ct { padding-right: 0; }
    .wb-form-actions { flex-direction: column; align-items: stretch; gap: 12px; }
  }
</style>

<script define:vars={{ DEFAULT_DATA, CATS }}>
  var LS_KEY = 'wb_links_v1';
  var DRAFT_KEY = 'wb_draft_v1';
  var CATS_KEY = 'wb_cats_v1';
  var NEW_CAT_COLORS = ['#f778ba', '#58a6ff', '#3fb950', '#d29922', '#a371f7', '#ff7b72', '#79c0ff'];
  var STATE = { all: [], tab: '作品', cat: '全部', q: '', editingId: null };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function $(id) { return document.getElementById(id); }
  function catColor(k) { for (var i = 0; i < CATS.length; i++) { if (CATS[i].k === k) return CATS[i].c; } return '#8b949e'; }
  function isLocal(u) { return String(u).indexOf('file://') === 0; }
  function isExternal(u) { return !isLocal(u) && u.indexOf('/') !== 0; }

  function loadLocal() {
    try { var v = localStorage.getItem(LS_KEY); return v ? JSON.parse(v) : null; } catch (e) { return null; }
  }
  function saveLocal(rows) {
    try { localStorage.setItem(LS_KEY, JSON.stringify(rows)); } catch (e) {}
  }
  // 老版本 localStorage 数据的层级迁移：作品层→作品，资源层→文章，未知→思考
  function migrateLayers(rows) {
    var map = { '作品层': '作品', '资源层': '文章' };
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      if (map[r.layer]) r.layer = map[r.layer];
      if (['作品', '文章', '思考'].indexOf(r.layer) < 0) r.layer = '思考';
    }
    return rows;
  }
  function loadCustomCats() {
    try { var v = JSON.parse(localStorage.getItem(CATS_KEY) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; }
  }
  function saveCustomCats(list) { try { localStorage.setItem(CATS_KEY, JSON.stringify(list)); } catch (e) {} }
  function addCustomCat(name) {
    name = String(name || '').trim();
    if (!name) return false;
    for (var i = 0; i < CATS.length; i++) { if (CATS[i].k === name) { toast('分类「' + name + '」已存在', 'err'); return false; } }
    var c = { k: name, c: NEW_CAT_COLORS[loadCustomCats().length % NEW_CAT_COLORS.length] };
    var list = loadCustomCats(); list.push(c); saveCustomCats(list);
    CATS.push(c); fillCatOptions(); renderChips(); $('f_cat').value = name;
    toast('已新增分类「' + name + '」');
    return true;
  }

  function saveDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        t: $('f_title').value, u: $('f_url').value, l: $('f_layer').value,
        c: $('f_cat').value, s: $('f_status').value, d: $('f_desc').value, p: $('f_pin').checked
      }));
    } catch (e) {}
  }
  function clearDraft() { try { localStorage.removeItem(DRAFT_KEY); } catch (e) {} }
  function restoreDraft() {
    try {
      var d = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); if (!d) return;
      $('f_title').value = d.t || ''; $('f_url').value = d.u || '';
      $('f_layer').value = ['作品', '文章', '思考'].indexOf(d.l) >= 0 ? d.l : '文章';
      $('f_cat').value = d.c || CATS[0].k;
      $('f_desc').value = d.d || ''; $('f_status').value = d.s || '已发布';
      $('f_pin').checked = !!d.p;
    } catch (e) {}
  }

  function findRow(id) {
    for (var i = 0; i < STATE.all.length; i++) { if (STATE.all[i]._id === id) return STATE.all[i]; }
    return null;
  }
  function published(r) { return r.status !== '待整理'; }

  function toast(msg, kind) {
    var el = $('msg'); if (!el) return;
    el.textContent = msg;
    el.className = 'wb-msg show' + (kind ? ' ' + kind : '');
    setTimeout(function () { el.className = 'wb-msg'; }, 2600);
  }

  function renderStats() {
    var w = 0, a = 0, t = 0;
    for (var i = 0; i < STATE.all.length; i++) {
      var r = STATE.all[i];
      if (r.layer === '作品') { w++; }
      else if (r.layer === '文章') { a++; }
      else { t++; }
    }
    $('s1').textContent = w; $('s2').textContent = a; $('s3').textContent = t; $('s4').textContent = STATE.all.length;
    $('n1').textContent = w; $('n2').textContent = a; $('n3').textContent = t;
  }

  function pinHtml(r) {
    var u = r.url, local = isLocal(u), ext = isExternal(u);
    var aAttr = local
      ? 'href="#" data-copy="' + esc(u) + '"'
      : 'href="' + esc(u) + '"' + (ext ? ' target="_blank" rel="noopener"' : '') + ' data-hit="' + esc(r._id) + '"';
    var catC = catColor(r.cat);
    return '<a class="wb-pin" ' + aAttr + ' style="--pin-color:' + catC + '">' +
      '<div class="wb-pt">' + esc(r.title) + '</div>' +
      '<div class="wb-pd">' + esc(r.desc || r.url) + '</div></a>';
  }
  function renderPins() {
    var rows = STATE.all.filter(function (r) { return r.pin && published(r); });
    var box = $('pins');
    if (!rows.length) { box.innerHTML = '<div class="wb-empty" style="flex:1">还没有置顶项 · 在卡片上点「置顶」试试</div>'; return; }
    box.innerHTML = rows.map(pinHtml).join('');
  }

  function renderChips() {
    var box = $('chips'), html = '';
    html += '<button class="wb-chip' + (STATE.cat === '全部' ? ' on' : '') + '" data-cat="全部">全部</button>';
    for (var i = 0; i < CATS.length; i++) {
      var c = CATS[i];
      html += '<button class="wb-chip' + (STATE.cat === c.k ? ' on' : '') + '" data-cat="' + esc(c.k) + '">' +
        '<span class="wb-dot" style="background:' + c.c + '"></span>' + esc(c.k) + '</button>';
    }
    box.innerHTML = html;
  }

  function visible() {
    var q = STATE.q.trim().toLowerCase();
    return STATE.all.filter(function (r) {
      if (r.layer !== STATE.tab) return false;
      if (STATE.cat !== '全部' && r.cat !== STATE.cat) return false;
      if (q) { var t = (r.title || '') + ' ' + (r.desc || '') + ' ' + (r.cat || ''); if (t.toLowerCase().indexOf(q) < 0) return false; }
      return true;
    });
  }

  function cardHtml(r) {
    var id = esc(r._id);
    var ops = published(r)
      ? '<button class="wb-op" data-edit="' + id + '">编辑</button>' +
        '<button class="wb-op" data-pin="' + id + '">' + (r.pin ? '取消置顶' : '置顶') + '</button>' +
        '<button class="wb-op del" data-del="' + id + '">删除</button>'
      : '<button class="wb-op" data-pub="' + id + '">发布</button>' +
        '<button class="wb-op" data-edit="' + id + '">编辑</button>' +
        '<button class="wb-op del" data-del="' + id + '">删除</button>';
    var u = r.url, local = isLocal(u), ext = isExternal(u);
    var aAttr = local
      ? 'href="#" data-copy="' + esc(u) + '"'
      : 'href="' + esc(u) + '"' + (ext ? ' target="_blank" rel="noopener"' : '') + ' data-hit="' + id + '"';
    var catC = catColor(r.cat);
    return '<div class="wb-card">' +
      '<div class="wb-card-ops">' + ops + '</div>' +
      '<div class="wb-ct"><span class="wb-dot" style="background:' + catC + '"></span>' +
      '<a ' + aAttr + '>' + esc(r.title) + '</a>' + (local ? '<span class="wb-pill">本地</span>' : '') + '</div>' +
      '<div class="wb-cd">' + esc(r.desc || '') + '</div>' +
      '<div class="wb-cf"><span class="wb-pill" style="border-color:' + catC + ';color:' + catC + ';background:' + catC + '10">' + esc(r.cat || '未分类') + '</span>' +
      '<span class="wb-hits">' + esc(r.hits || 0) + ' 次访问</span></div></div>';
  }

  function renderList() {
    var rows = visible(), box = $('list');
    if (!rows.length) { box.innerHTML = '<div class="wb-empty">这里还没有内容 · 用下方表单添加第一条</div>'; return; }
    var cls = STATE.tab === '作品' ? 'wb-grid works' : 'wb-grid res';
    box.innerHTML = '<div class="' + cls + '">' + rows.map(cardHtml).join('') + '</div>';
  }

  function refreshAll() { renderStats(); renderPins(); renderChips(); renderList(); }

  function readForm() {
    var t = $('f_title').value.trim();
    var u = $('f_url').value.trim();
    if (!t || !u) { toast('标题和链接必填', 'err'); return null; }
    if (!/^https?:\/\//i.test(u) && !isLocal(u) && u.indexOf('/') !== 0) { u = 'https://' + u; }
    var hits = 0;
    if (STATE.editingId) { var ex = findRow(STATE.editingId); if (ex) hits = ex.hits || 0; }
    return {
      _id: STATE.editingId || ('local_' + Date.now()),
      title: t, url: u, layer: $('f_layer').value, cat: $('f_cat').value,
      desc: $('f_desc').value.trim(), status: $('f_status').value,
      pin: $('f_pin').checked, hits: hits, created: new Date().toISOString().slice(0, 10)
    };
  }

  function fillCatOptions() {
    var sel = $('f_cat'), cur = sel.value;
    sel.innerHTML = CATS.map(function (c) { return '<option>' + esc(c.k) + '</option>'; }).join('');
    if (cur) sel.value = cur;
  }

  function cancelEdit() {
    STATE.editingId = null; clearDraft();
    $('addForm').reset(); fillCatOptions();
    $('formT').textContent = '添加一条'; $('submitBtn').textContent = '添加';
    $('cancelBtn').style.display = 'none';
  }

  function startEdit(id) {
    var r = findRow(id); if (!r) return;
    STATE.editingId = id; fillCatOptions();
    $('f_title').value = r.title || ''; $('f_url').value = r.url || '';
    $('f_layer').value = ['作品', '文章', '思考'].indexOf(r.layer) >= 0 ? r.layer : '文章';
    $('f_cat').value = r.cat || CATS[0].k;
    $('f_desc').value = r.desc || ''; $('f_status').value = r.status || '已发布';
    $('f_pin').checked = !!r.pin;
    $('formT').textContent = '编辑 · ' + r.title; $('submitBtn').textContent = '保存修改';
    $('cancelBtn').style.display = '';
    window.scrollTo({ top: document.querySelector('.wb-form').offsetTop - 20, behavior: 'smooth' });
  }

  function bumpHit(id) {
    var r = findRow(id); if (!r) return;
    r.hits = (r.hits || 0) + 1; saveLocal(STATE.all);
  }

  function persist() { saveLocal(STATE.all); refreshAll(); }

  function copyPath(u) {
    var p = String(u).replace(/^file:\/\//, '').replace(/\/$/, '');
    var done = function () { toast('本地路径已复制'); };
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(p).then(done, function () { fallbackCopy(p); });
        return;
      }
    } catch (e) {}
    fallbackCopy(p);
  }
  function fallbackCopy(t) {
    try {
      var ta = document.createElement('textarea');
      ta.value = t; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      toast(t);
    } catch (e) { toast(t); }
  }

  function bindEvents() {
    document.querySelector('.wb-tabs').addEventListener('click', function (e) {
      var b = e.target.closest('.wb-tab'); if (!b) return;
      STATE.tab = b.dataset.tab;
      var ts = document.querySelectorAll('.wb-tab');
      for (var i = 0; i < ts.length; i++) { ts[i].className = 'wb-tab' + (ts[i].dataset.tab === STATE.tab ? ' on' : ''); }
      renderList();
    });

    $('chips').addEventListener('click', function (e) {
      var b = e.target.closest('.wb-chip'); if (!b) return;
      STATE.cat = b.dataset.cat; renderChips(); renderList();
    });

    $('q').addEventListener('input', function (e) { STATE.q = e.target.value; renderList(); });

    $('list').addEventListener('click', function (e) {
      var cp = e.target.closest('[data-copy]');
      if (cp) { e.preventDefault(); copyPath(cp.dataset.copy); return; }
      var hit = e.target.closest('[data-hit]');
      if (hit) { bumpHit(hit.dataset.hit); setTimeout(function () { renderPins(); renderStats(); }, 200); return; }
      var ed = e.target.closest('[data-edit]');
      if (ed) { startEdit(ed.dataset.edit); return; }
      var dl = e.target.closest('[data-del]');
      if (dl) {
        if (!confirm('确定删除这条？')) return;
        STATE.all = STATE.all.filter(function (r) { return r._id !== dl.dataset.del; });
        persist(); toast('已删除'); return;
      }
      var pb = e.target.closest('[data-pub]');
      if (pb) { var r = findRow(pb.dataset.pub); if (r) { r.status = '已发布'; persist(); toast('已发布'); } return; }
      var pn = e.target.closest('[data-pin]');
      if (pn) { var rr = findRow(pn.dataset.pin); if (rr) { rr.pin = !rr.pin; persist(); toast('已更新'); } }
    });

    $('pins').addEventListener('click', function (e) {
      var cp = e.target.closest('[data-copy]');
      if (cp) { e.preventDefault(); copyPath(cp.dataset.copy); return; }
      var hit = e.target.closest('[data-hit]');
      if (hit) { bumpHit(hit.dataset.hit); setTimeout(function () { renderPins(); renderStats(); }, 200); }
    });

    $('addForm').addEventListener('input', saveDraft);

    $('addCatBtn').addEventListener('click', function () {
      $('f_cat').style.display = 'none'; this.style.display = 'none';
      var inp = $('f_newcat'); inp.style.display = ''; inp.focus();
    });
    function closeNewCat() {
      $('f_cat').style.display = ''; $('addCatBtn').style.display = '';
      var inp = $('f_newcat'); inp.style.display = 'none'; inp.value = '';
    }
    $('f_newcat').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (addCustomCat(this.value)) saveDraft();
        closeNewCat();
      } else if (e.key === 'Escape') {
        closeNewCat();
      }
    });
    $('f_newcat').addEventListener('blur', function () { setTimeout(closeNewCat, 120); });

    $('addForm').addEventListener('submit', function (e) {
      e.preventDefault();
      var data = readForm(); if (!data) return;
      var btn = $('submitBtn'); btn.disabled = true;
      if (STATE.editingId) { STATE.all = STATE.all.map(function (r) { return r._id === STATE.editingId ? data : r; }); }
      else { STATE.all.push(data); }
      persist(); btn.disabled = false;
      toast(STATE.editingId ? '已保存' : '已添加'); cancelEdit();
    });

    $('cancelBtn').addEventListener('click', cancelEdit);

    $('expBtn').addEventListener('click', function () {
      var blob = new Blob([JSON.stringify(STATE.all, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'workbench_backup_' + new Date().toISOString().slice(0, 10) + '.json';
      a.click();
    });

    $('impBtn').addEventListener('click', function () { $('impFile').click(); });
    $('impFile').addEventListener('change', function (e) {
      var f = e.target.files[0]; if (!f) return;
      var fr = new FileReader();
      fr.onload = function () {
        try {
          var rows = JSON.parse(fr.result);
          if (!Array.isArray(rows)) throw new Error('bad');
          saveLocal(rows); STATE.all = rows; refreshAll(); toast('已导入');
        } catch (err) { toast('文件格式不对', 'err'); }
      };
      fr.readAsText(f);
    });

    $('clrBtn').addEventListener('click', function () {
      if (!confirm('将清空全部记录，确定？')) return;
      STATE.all = []; persist(); toast('已清空');
    });
  }

  function init() {
    // 注意：define:vars 注入的 CATS 是 const，只能原地 push，不能重新赋值
    CATS.push.apply(CATS, loadCustomCats());
    fillCatOptions(); restoreDraft(); bindEvents();
    var loaded = loadLocal();
    if (loaded && Array.isArray(loaded) && loaded.length) { STATE.all = migrateLayers(loaded); saveLocal(STATE.all); }
    else { STATE.all = DEFAULT_DATA.slice(); saveLocal(STATE.all); }
    refreshAll();
  }
  init();
</script>
