---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/helpers';

interface Props {
  note: CollectionEntry<'notes'>;
  /** 若传入 href，整张卡片通过拉伸链接可点；否则为纯展示 */
  href?: string;
}

const { note, href } = Astro.props;
const { date, tags, image } = note.data;
// 用正文前若干字作为图片 alt，保证无障碍可读
const altText = (note.body || '').replace(/\s+/g, ' ').slice(0, 40) || '思考配图';
---

<!--
  注意：卡片根节点必须是 <article>，不能是 <a>。
  卡内还有标签 <a>，若外层也是 <a>，浏览器解析到内层链接会强制闭合外层，
  DOM 会被撕碎成大量空卡片（此前 /notes 页 8 条笔记炸成 40 张卡的根因）。
  整卡可点改用「拉伸链接」：透明的 <a.note-stretch> 铺满卡片，标签提高层级保持可点。
-->
<article class="note-card">
  {
    image && (
      <div class="note-cover">
        <img src={image} alt={altText} loading="lazy" width="600" height="400" />
      </div>
    )
  }
  <div class="note-content">
    <p class="note-text">{note.body}</p>
    <div class="note-foot">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {href && <a class="note-stretch" href={href} aria-hidden="true" tabindex="-1" />}
</article>

<style>
  .note-card {
    position: relative;
    display: block;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.4rem 1.5rem;
    color: inherit;
    transition: border-color var(--t-base), transform var(--t-base), box-shadow var(--t-base);
  }

  .note-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  /* 拉伸链接：透明铺满整卡，让卡片整体可点 */
  .note-stretch {
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* 标签与时间提高层级，不被拉伸链接挡住 */
  .note-foot .tag,
  .note-foot time {
    position: relative;
    z-index: 1;
  }

  .note-cover {
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 1rem;
    background: var(--bg-soft);
  }

  .note-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .note-text {
    color: var(--text);
    font-size: 0.9875rem;
    line-height: 1.8;
    white-space: pre-wrap;
  }

  .note-foot {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .note-foot .tag-list {
    gap: 0.35rem;
  }
</style>
