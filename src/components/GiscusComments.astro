---
/**
 * Giscus 评论组件
 *
 * 使用方式：
 * 1. 前往 https://giscus.app/zh-CN 生成配置，拿到 repo / repoId / category / categoryId
 * 2. 在 .env 或构建时注入：
 *    PUBLIC_GISCUS_REPO=用户名/仓库
 *    PUBLIC_GISCUS_REPO_ID=...
 *    PUBLIC_GISCUS_CATEGORY=Announcements
 *    PUBLIC_GISCUS_CATEGORY_ID=...
 * 3. 重新构建即可加载评论区
 *
 * 未配置时显示占位提示。
 */

const repo = import.meta.env.PUBLIC_GISCUS_REPO || '';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || '';
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || '';
const configured = !!(repo && repoId && categoryId);
---

<section class="giscus-section" aria-label="评论">
  <h2 class="giscus-title">评论</h2>

  {
    configured ? (
      <div
        class="giscus"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
      />
    ) : (
      <div class="giscus-placeholder">
        <p>评论功能由 Giscus 提供，需要配置 GitHub 仓库。</p>
        <p>
          前往 <a href="https://giscus.app/zh-CN" target="_blank" rel="noopener">giscus.app/zh-CN</a>
          生成配置，并设置以下环境变量后重新构建：
        </p>
        <ul>
          <li><code>PUBLIC_GISCUS_REPO</code></li>
          <li><code>PUBLIC_GISCUS_REPO_ID</code></li>
          <li><code>PUBLIC_GISCUS_CATEGORY_ID</code></li>
        </ul>
      </div>
    )
  }
</section>

{
  configured && (
    <script src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    />
  )
}

<style>
  .giscus-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-soft);
  }

  .giscus-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .giscus-placeholder {
    padding: 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    color: var(--text-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .giscus-placeholder p {
    margin-bottom: 0.5rem;
  }

  .giscus-placeholder ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }

  .giscus-placeholder code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    background: var(--card);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .giscus-placeholder a {
    color: var(--accent);
  }
</style>
