---
/**
 * Giscus 评论组件（基于 GitHub Discussions）
 *
 * 配置已通过 GitHub GraphQL API 自动完成（2026-09-04）：
 * - 仓库已开启 Discussions，分类 Announcements（仅维护者可发起，访客可评论）
 * - 以下四个值均为公开信息（会明文出现在客户端 bundle 中，giscus 设计如此），
 *   故直接作为默认值内置，本地与 GitHub Actions 构建均生效；
 *   仍可用 .env 中的 PUBLIC_GISCUS_* 变量覆盖。
 */

const repo = import.meta.env.PUBLIC_GISCUS_REPO || 'wilkessidney/wilkessidney.github.io';
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOUJw_gg';
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements';
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOUJw_gs4DE2EY';
const configured = !!(repo && repoId && categoryId);
---

<section class="giscus-section" aria-label="评论">
  <h2 class="giscus-title">评论</h2>

  {
    configured ? (
      <div
        class="giscus"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
      />
    ) : (
      <div class="giscus-placeholder">
        <p>评论功能由 Giscus 提供，需要配置 GitHub 仓库。</p>
        <p>
          前往 <a href="https://giscus.app/zh-CN" target="_blank" rel="noopener">giscus.app/zh-CN</a>
          生成配置，并设置以下环境变量后重新构建：
        </p>
        <ul>
          <li><code>PUBLIC_GISCUS_REPO</code></li>
          <li><code>PUBLIC_GISCUS_REPO_ID</code></li>
          <li><code>PUBLIC_GISCUS_CATEGORY_ID</code></li>
        </ul>
      </div>
    )
  }
</section>

{
  configured && (
    <script src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    />
  )
}

<style>
  .giscus-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-soft);
  }

  .giscus-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .giscus-placeholder {
    padding: 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-soft);
    color: var(--text-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .giscus-placeholder p {
    margin-bottom: 0.5rem;
  }

  .giscus-placeholder ul {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
  }

  .giscus-placeholder code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    background: var(--card);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }

  .giscus-placeholder a {
    color: var(--accent);
  }
</style>
