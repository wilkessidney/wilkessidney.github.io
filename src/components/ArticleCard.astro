---
import type { CollectionEntry } from 'astro:content';
import { formatDate, calcReadingTime } from '../utils/helpers';

interface Props {
  article: CollectionEntry<'articles'>;
  /** 是否显示摘要 */
  showSummary?: boolean;
}

const { article, showSummary = true } = Astro.props;
const {
  title,
  date,
  summary,
  category,
  tags,
  readingTime,
  featured,
  draft,
} = article.data;
const minutes = readingTime ?? calcReadingTime(article.body ?? '');
---

<article class="card card-link article-card">
  <a class="article-head" href={`/writing/${article.id}`}>
    <h3 class="article-title">
      {title}
      {draft && <span class="badge">草稿</span>}
      {featured && <span class="badge badge-accent">精选</span>}
    </h3>
  </a>

  {showSummary && <p class="article-summary">{summary}</p>}

  <div class="article-foot">
    <div class="meta-line">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{category}</span>
      <span aria-hidden="true">·</span>
      <span>{minutes} 分钟</span>
    </div>
    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li>
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .article-head {
    color: inherit;
  }

  .article-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.01em;
    transition: color var(--t-fast);
  }

  .article-head:hover .article-title,
  .article-head:focus-visible .article-title {
    color: var(--accent);
  }

  .badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0 0.35rem;
    margin-left: 0.45rem;
    vertical-align: 0.1em;
  }

  .badge-accent {
    color: var(--accent);
    border-color: var(--accent);
  }

  .article-summary {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-foot {
    margin-top: auto;
    padding-top: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .meta-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    flex-wrap: wrap;
  }
</style>
