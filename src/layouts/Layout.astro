---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** 是否为内容详情页（输出 article 相关 meta） */
  article?: boolean;
  pubDate?: Date;
  tags?: string[];
  noindex?: boolean;
}

const t = useTranslations();
const { title, description, ogImage, article, pubDate, tags, noindex } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      article={article}
      pubDate={pubDate}
      tags={tags}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
