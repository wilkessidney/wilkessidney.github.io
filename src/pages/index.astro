---
import Layout from '../layouts/Layout.astro';
import Workbench from '../components/Workbench.astro';
import { getCollection } from 'astro:content';

const [profileEntry] = await getCollection('profile');
const profile = profileEntry?.data;

const title = `${profile?.name ?? '拾光'} · 工作台`;
const description = '个人工作台：作品、资源与在 build 的东西，一处直达。';
---

<Layout title={title} description={description}>
  <Workbench />
</Layout>
