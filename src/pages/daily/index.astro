---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { byDateDesc, formatDate, formatDateISO } from '../../utils/helpers';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations();
const plans = byDateDesc(await getCollection('daily'));
---

<Layout title={t('daily.title')} description={t('daily.desc')}>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h1 class="page-title">{t('daily.title')}</h1>
          <p class="page-desc">{t('daily.desc')}</p>
        </div>
        <button class="btn btn-primary" id="daily-new-btn" type="button">新建日计划</button>
      </div>

      <form class="daily-form card" id="daily-form" hidden>
        <h2 class="daily-form-title">新建日计划</h2>
        <div class="daily-form-grid">
          <label class="daily-field">
            <span>日期</span>
            <input type="date" name="date" required />
          </label>
          <label class="daily-field">
            <span>状态</span>
            <select name="status" required>
              <option value="规划中">规划中</option>
              <option value="进行中" selected>进行中</option>
              <option value="已完成">已完成</option>
              <option value="复盘">复盘</option>
            </select>
          </label>
        </div>
        <label class="daily-field">
          <span>任务（每行一条，已完成的行前加 [x]）</span>
          <textarea name="tasks" rows="5" placeholder="- [ ] 重构工作台首页\n- [x] 新增日计划归档\n- [ ] 文章与思考页接入社交功能"></textarea>
        </label>
        <label class="daily-field">
          <span>一句话总结</span>
          <input type="text" name="summary" placeholder="今天最核心的进展或复盘" />
        </label>
        <label class="daily-field">
          <span>标签（逗号分隔）</span>
          <input type="text" name="tags" placeholder="站点迭代, 日计划" />
        </label>
        <div class="daily-form-actions">
          <button class="btn" type="button" id="daily-cancel-btn">取消</button>
          <button class="btn btn-primary" type="submit">生成并下载 Markdown</button>
        </div>
        <p class="daily-form-hint">
          下载后把文件放到 <code>src/content/daily/YYYY-MM-DD.md</code>，提交即可生效。
        </p>
      </form>

      <div class="daily-list">
        {
          plans.map((plan) => {
            const doneCount = plan.data.tasks.filter((t) => t.done).length;
            const total = plan.data.tasks.length;
            const progress = total > 0 ? Math.round((doneCount / total) * 100) : 0;
            return (
              <article class="card daily-card">
                <div class="daily-header">
                  <time class="daily-date" datetime={plan.data.date.toISOString()}>
                    {formatDate(plan.data.date)}
                  </time>
                  <span class={`daily-status daily-status-${plan.data.status}`}>
                    {plan.data.status}
                  </span>
                </div>

                {plan.data.summary && <p class="daily-summary">{plan.data.summary}</p>}

                {total > 0 && (
                  <div class="daily-progress">
                    <div class="daily-progress-bar" style={`width: ${progress}%`} />
                    <span class="daily-progress-text">{doneCount}/{total}</span>
                  </div>
                )}

                <ul class="daily-tasks">
                  {plan.data.tasks.map((task) => (
                    <li class={`daily-task${task.done ? ' is-done' : ''}`}>
                      <span class="daily-checkbox" aria-hidden="true" />
                      <span>{task.text}</span>
                    </li>
                  ))}
                </ul>

                {plan.data.tags.length > 0 && (
                  <ul class="tag-list daily-tags">
                    {plan.data.tags.map((tag) => (
                      <li>
                        <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>
                          {tag}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            );
          })
        }
        {
          plans.length === 0 && (
            <p class="empty-state">还没有日计划，从记录今天开始吧。</p>
          )
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .daily-list {
    display: grid;
    gap: 1.25rem;
  }

  .daily-card {
    padding: 1.25rem 1.5rem;
  }

  .daily-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .daily-date {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .daily-status {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-soft);
  }

  .daily-status-已完成,
  .daily-status-复盘 {
    color: var(--success, #3fb950);
    border-color: var(--success, #3fb950);
  }

  .daily-status-进行中 {
    color: var(--accent);
    border-color: var(--accent);
  }

  .daily-summary {
    font-size: 0.9375rem;
    color: var(--text-soft);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .daily-progress {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .daily-progress-bar {
    height: 6px;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  .daily-progress-text {
    font-size: 0.75rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  .daily-tasks {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .daily-task {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text);
  }

  .daily-task.is-done {
    color: var(--text-faint);
    text-decoration: line-through;
  }

  .daily-checkbox {
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--border);
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .daily-task.is-done .daily-checkbox {
    background: var(--accent-soft);
    border-color: var(--accent);
    position: relative;
  }

  .daily-task.is-done .daily-checkbox::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.05rem;
    width: 0.25rem;
    height: 0.5rem;
    border: solid var(--accent);
    border-width: 0 0 1.5px 1.5px;
    transform: rotate(-45deg);
  }

  .daily-tags {
    margin-top: 1rem;
  }

  .daily-form {
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .daily-form[hidden] {
    display: none;
  }

  .daily-form-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .daily-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .daily-form-grid {
      grid-template-columns: 1fr;
    }
  }

  .daily-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.875rem;
  }

  .daily-field + .daily-field {
    margin-top: 1rem;
  }

  .daily-field span {
    color: var(--text-soft);
  }

  .daily-field input,
  .daily-field select,
  .daily-field textarea {
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font-size: 0.9375rem;
  }

  .daily-field input:focus,
  .daily-field select:focus,
  .daily-field textarea:focus {
    outline: 2px solid var(--accent-ring);
    border-color: var(--accent);
  }

  .daily-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .daily-form-hint {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .daily-form-hint code {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    background: var(--bg-soft);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all var(--t-fast);
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--bg);
  }
</style>

<script>
  (function () {
    const newBtn = document.getElementById('daily-new-btn');
    const cancelBtn = document.getElementById('daily-cancel-btn');
    const form = document.getElementById('daily-form') as HTMLFormElement;
    if (!newBtn || !cancelBtn || !form) return;

    newBtn.addEventListener('click', () => {
      form.hidden = false;
      newBtn.hidden = true;
      const dateInput = form.querySelector<HTMLInputElement>('input[name="date"]');
      if (dateInput && !dateInput.value) {
        dateInput.value = new Date().toISOString().slice(0, 10);
      }
      form.querySelector<HTMLElement>('input, select, textarea')?.focus();
    });

    cancelBtn.addEventListener('click', () => {
      form.hidden = true;
      newBtn.hidden = false;
      form.reset();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const date = String(fd.get('date') || new Date().toISOString().slice(0, 10));
      const status = String(fd.get('status') || '进行中');
      const tasksRaw = String(fd.get('tasks') || '').trim();
      const summary = String(fd.get('summary') || '').trim();
      const tagsRaw = String(fd.get('tags') || '').trim();

      const tasks = tasksRaw
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean)
        .map((line) => {
          const done = line.startsWith('[x]') || line.startsWith('- [x]');
          const text = line.replace(/^(- )?\[[x ]\] ?/i, '').trim();
          return `  - text: ${text}\n    done: ${done}`;
        });

      const tags = tagsRaw
        .split(/[,，]/)
        .map((t) => t.trim())
        .filter(Boolean);

      const frontmatter = [
        '---',
        `date: ${date}`,
        `status: ${status}`,
        tasks.length > 0 ? `tasks:\n${tasks.join('\n')}` : 'tasks: []',
        summary ? `summary: ${summary}` : '',
        tags.length > 0 ? `tags: [${tags.join(', ')}]` : '',
        '---',
        '',
      ]
        .filter(Boolean)
        .join('\n');

      const blob = new Blob([frontmatter], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${date}.md`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);

      form.hidden = true;
      newBtn.hidden = false;
      form.reset();
    });
  })();
</script>
